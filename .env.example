# Copier ce fichier en .env et remplir les valeurs. Ne JAMAIS versionner .env.

# --- Django ---
SECRET_KEY=                       # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=easyschoolcameroon.com,www.easyschoolcameroon.com
CSRF_TRUSTED_ORIGINS=https://easyschoolcameroon.com,https://www.easyschoolcameroon.com
ADMIN_URL=une-url-admin-difficile-a-deviner/
BASE_URL=https://easyschoolcameroon.com/
SITE_DOMAIN=easyschoolcameroon.com       # domaine utilisé dans les e-mails

# --- Base de données (au choix) ---
DATABASE_URL=postgres://user:motdepasse@hote:5432/easyschool
# ou bien :
# POSTGRES_DB=easyschool
# POSTGRES_USER=easyschool
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db

# --- Redis / Celery (optionnel : sans Redis les tâches s'exécutent directement) ---
REDIS_URL=redis://easyschool_redis:6379/1

# --- E-mail (Brevo) ---
EMAIL_HOST_USER=no-reply@easyschoolcameroon.com
BREVO_API_KEY=

# --- Stockage S3 / CloudFront (optionnel) ---
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
AWS_CLOUDFRONT_KEY_ID=
AWS_CLOUDFRONT_KEY=               # clé privée sur une ligne, retours à la ligne écrits \n

# --- Médias sans S3 ---
SERVE_MEDIA=False                 # True seulement sur un hébergement sans S3 ni nginx (Render gratuit)
PRIVATE_MEDIA_ROOT=               # dossier des épreuves déposées (jamais servi publiquement)

# --- IA ---
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Dépôt d'épreuves ---
DEPOT_RECOMPENSE_FCFA=25
DEPOT_TAILLE_MAX_MO=10
DEPOT_LIMITE_PAR_JOUR=20
DEPOT_PUBLICATION_AUTO=True      # False : les épreuves attendent ta publication dans l'admin

# --- Protection des contenus ---
MAX_APPAREILS_PAR_COMPTE=2
PROTECTION_LIMITE_PAR_HEURE=120

# --- Espace professeurs ---
PROF_COMMISSION_PLATEFORME=30      # % gardé par EasySchool
PROF_DELAI_DISPONIBILITE_JOURS=7
PROF_RETRAIT_MINIMUM=5000
PROF_VIDEO_TAILLE_MAX_MO=300
PROF_PDF_TAILLE_MAX_MO=30
